# Hive — Environment Variables
# Copy this to .env and fill in values before running

# --- Server ---
# Secret key for signing JWT tokens. Change this to a long random string in production.
JWT_SECRET_KEY=hive-local-secret-change-me-in-production

# Ollama base URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use.
# "hive-fast" is the optimized build (qwen2.5:1.5b + tuned params) — build it with:
#   ollama create hive-fast -f setup/Modelfile
# Fallback to raw qwen2.5:1.5b if you skip the Modelfile build.
OLLAMA_MODEL=hive-fast

# Morning briefing time (24h format, server local time)
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# --- Client (prefix with VITE_ to expose to browser) ---
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# When deploying on Pi and accessing from phone on same network,
# replace localhost with Pi's local IP (e.g. 192.168.1.100)
# VITE_API_BASE=http://192.168.1.100:8000
# VITE_WS_BASE=ws://192.168.1.100:8000
